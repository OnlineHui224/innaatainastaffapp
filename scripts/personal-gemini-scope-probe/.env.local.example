# HajjERP — Personal Gemini M1.0 scope probe
#
# Copy this file to `.env.local` IN THIS DIRECTORY and fill in the values.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored (the repository root ignores `*.local`) and an
# explicit rule was added for this directory as well. Never commit it, never
# paste its contents into a chat, an issue or a pull request.

# ── From Google Cloud Console → APIs & Services → Credentials ───────────────
# The OAuth 2.0 Client ID you created for this probe. Ends in
# .apps.googleusercontent.com and is not itself sensitive, but keep it here
# alongside the secret for convenience.
GOOGLE_OAUTH_CLIENT_ID=

# The client secret shown next to it. THIS IS A SECRET.
# It belongs only in this file, on your machine.
GOOGLE_OAUTH_CLIENT_SECRET=

# ── The Google Cloud project whose Gemini quota should be charged ───────────
# The canonical PROJECT ID — the hyphenated one, e.g. hajjerp-gemini-probe.
# NOT the display name, and NOT the 12-digit project number.
PROBE_PROJECT_ID=

# ── Optional ───────────────────────────────────────────────────────────────
# Which scope set to test: A (narrow), B (cloud-platform), C (both).
# Always start at A. Only move on if A fails.
PROBE_PHASE=A

# Loopback listener. Must match the redirect URI registered on the OAuth client.
PROBE_PORT=8787
PROBE_REDIRECT_URI=http://localhost:8787/callback

# Pinned stable model. Do not use a preview, experimental or "latest" alias.
PROBE_MODEL=gemini-3.6-flash

# Which API surface to test: `generatecontent` (the M0 design) or `interactions`
# (Google's newer recommended surface). Run generatecontent first.
PROBE_API=generatecontent

# Set to 0 to skip the invalid-quota-project negative test.
PROBE_NEGATIVE=1
